[Unit]
Description=shortlist interactive Telegram bot — /screen and /deep on demand
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=oracle
WorkingDirectory=/opt/shortlist
ExecStart=/opt/shortlist/.venv/bin/shortlist-bot
Restart=on-failure
RestartSec=5
# Graceful shutdown can take ~40s (blocked long-poll read); must exceed that or
# systemd SIGKILLs mid-poll on every restart.
TimeoutStopSec=50

[Install]
WantedBy=multi-user.target
