# Sample only — not installed automatically. Edit the <PLACEHOLDER>s, then see README.md.
[Unit]
Description=shortlist daily point-in-time snapshot capture
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=<REPO_ROOT>
ExecStart=/usr/bin/env uv run shortlist-accumulate run --root <STORE_ROOT> --max-tickers 42
Nice=10
