# Copy to .env and fill in. .env is gitignored — never commit real keys.
# Set only the ones you need; missing providers are skipped with a warning.

FMP_API_KEY=
FINNHUB_API_KEY=
SEC_IDENTITY=you@example.com   # a contact email, required by SEC for EDGAR

# Telegram delivery for the autonomous scout's daily report (shortlist-scout).
# Both must be set for the bot to push the chart + HTML deep-dive to you; if
# either is missing, the scout falls back to writing the file artifact only.
# Telegram's own setup guide: https://core.telegram.org/bots/tutorial
#   TELEGRAM_BOT_TOKEN — talk to @BotFather, send /newbot, copy the HTTP API token
#                        (looks like 123456789:AAExxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx)
#   TELEGRAM_CHAT_ID   — your personal chat id. Message your new bot once, then open
#                        https://api.telegram.org/bot<TOKEN>/getUpdates and read
#                        result[].message.chat.id  (or DM @userinfobot).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional / scaffolded (not yet wired):
# QUIVER_API_KEY=
# FRED_API_KEY=
