# Copy to .env and fill in. .env is gitignored — never commit real keys.
# Set only the ones you need; a missing key skips that source with a warning.
# Keep comments on their own lines: `KEY=  # note` sets KEY to "# note".

# https://site.financialmodelingprep.com/ (free tier)
FMP_API_KEY=
# https://finnhub.io/ (free tier)
FINNHUB_API_KEY=
# Macro/regime overlay. Free key: https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=
# A contact email, required by SEC for EDGAR
SEC_IDENTITY=you@example.com

# Telegram bot (shortlist-bot). Setup: docs/TELEGRAM.md
#   TELEGRAM_BOT_TOKEN — from @BotFather: send /newbot, copy the HTTP API token
#   TELEGRAM_CHAT_ID   — your chat id; the bot answers only this chat
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
